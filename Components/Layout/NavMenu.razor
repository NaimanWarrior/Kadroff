@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Authorization

<nav class="navbar navbar-expand-lg navbar-dark px-4 py-2">
    <div class="container-fluid p-0">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold me-4" href="">
            <RadzenIcon Icon="badge" Style="font-size: 1.8rem; color: #38bdf8;" />
            <span style="font-size: 1.25rem; letter-spacing: 0.5px; color: #ffffff;">kadroff</span>
        </a>

        <div class="nav-horizontal">
            <NavLink class="custom-nav-btn" href="" Match="NavLinkMatch.All">
                <RadzenIcon Icon="home" />
                <span>Главная</span>
            </NavLink>

            <NavLink class="custom-nav-btn" href="positions">
                <RadzenIcon Icon="work" />
                <span>Вакансии</span>
            </NavLink>

            <AuthorizeView Roles="Admin, Recruiter">
                <NavLink class="custom-nav-btn" href="/manage-applications">
                    <RadzenIcon Icon="email" />
                    <span>Входящие отклики</span>
                </NavLink>
            </AuthorizeView>

            <AuthorizeView Roles="Candidate">
                <NavLink class="custom-nav-btn" href="/my-applications">
                    <RadzenIcon Icon="email" />
                    <span>Мои отклики</span>
                </NavLink>
            </AuthorizeView>

            <NavLink class="custom-nav-btn" href="/cv/my">
                <RadzenIcon Icon="description " />
                <span>Резюме</span>
            </NavLink>

        </div>

        <div class="d-flex align-items-center gap-2">
            <AuthorizeView>
                <Authorized>
                    <RadzenProfileMenu Style="background: transparent;">
                        <Template>
                            <RadzenIcon Icon="account_circle" Style="font-size: 1.8rem; color: #ffffff;" />
                        </Template>
                        <ChildContent>
                            <RadzenProfileMenuItem Text="@context.User.Identity?.Name" Icon="person" Disabled="true" />
                            <RadzenProfileMenuItem Text="Выйти" Icon="logout" Path="Account/Logout" />
                        </ChildContent>
                    </RadzenProfileMenu>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="custom-nav-btn" href="Account/Login" Match="NavLinkMatch.All">
                        <RadzenIcon Icon="Login" />
                        <span>Войти</span>
                    </NavLink>
                    <NavLink class="custom-nav-btn" href="Account/Register" Match="NavLinkMatch.All">
                        <RadzenIcon Icon="person_add" />
                        <span>Регистрация</span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

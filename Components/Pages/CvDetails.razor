@page "/cv/details/{CvId:long}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject CvService CvService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = "Admin, Candidate")]
@rendermode InteractiveServer

@if (details == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Загрузка данных резюме...</p>
    </div>
}
else
{
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a href="/cv/my" class="btn btn-outline-secondary btn-sm">&larr; Назад к списку</a>
        <a href="/api/cv/pdf/@CvId" target="_blank" class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf"></i> Открыть PDF версию
        </a>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Резюме: @details.Position?.Title</h4>
        </div>
        <div class="card-body">
            <p><strong>Описание вакансии:</strong> @details.Position?.Description</p>
            <p>
                <strong>Статус публикации:</strong>
                <span class="badge @(details.Cv.IsPublished ? "bg-success" : "bg-secondary")">
                    @(details.Cv.IsPublished ? "Опубликовано" : "Активен")
                </span>
            </p>
            <p class="mb-0"><strong>Дата создания:</strong> @details.Cv.CreatedAt.ToLocalTime().ToString("f")</p>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Атрибуты и Анкета кандидата</h5>
        </div>
        <div class="card-body">
            @if (!details.Attributes.Any())
            {
                <p class="text-muted mb-0">Атрибуты не заполнены.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Категория</th>
                                <th>Атрибут</th>
                                <th>Значение</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attr in details.Attributes)
                            {
                                <tr>
                                    <td>@attr.Attribute?.Category</td>
                                    <td>@attr.Attribute?.Name</td>
                                    <td>@attr.StringValue</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Проекты кандидата</h5>
        </div>
        <div class="card-body">
            @if (!details.Projects.Any())
            {
                <p class="text-muted mb-0">Проекты не добавлены.</p>
            }
            else
            {
                @foreach (var proj in details.Projects)
                {
                    <div class="border rounded p-3 mb-3 bg-light">
                        <h6 class="fw-bold">@proj.Name</h6>
                        <p class="mb-2">@proj.DescriptionMarkdown</p>
                        <small class="text-muted d-block mb-2">
                            <i class="bi bi-calendar"></i> Период: @(proj.StartDate?.ToString("yyyy-MM") ?? "N/A") — @(proj.EndDate?.ToString("yyyy-MM") ?? "По настоящее время")
                        </small>

                        @if (proj.Tags != null && proj.Tags.Any())
                        {
                            <div>
                                @foreach (var tag in proj.Tags)
                                {
                                    <span class="badge bg-white text-dark border me-1">@tag</span>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public long CvId { get; set; }
    private CvFullDetailsDto? details;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            details = await CvService.GetCvFullDetailsAsync(CvId, userId);
        }
    }
}